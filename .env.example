# Correr — dotenv template
# Copy to .env.development.local and fill real values.
# Never commit .env* files or their contents to version control.

# Convex
# EXPO_PUBLIC_CONVEX_URL=           # set when you run `npx convex dev`

# Convex Auth (server-side env — set with `npx convex env set`, not dotenv)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# SITE_URL=http://localhost:8081   # web origin; native deep links use `correr://`

# OpenRouter (Convex server-side env — set with `npx convex env set`)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b   # optional; defaults to the above
# OPENROUTER_SITE_URL=https://correr.app # optional; defaults to the above
# OPENROUTER_APP_NAME=Correr            # optional; defaults to the above
